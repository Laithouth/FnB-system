# Copy to .env and adjust. No secrets have defaults; nothing here is a
# real credential.

# "faster_whisper" (default): production-quality accuracy, needed to
#   reliably catch order vocabulary. Needs network access to Hugging Face
#   on first run (downloads model weights) and enough CPU/GPU headroom.
#   Unverified in this project's own dev sandbox -- see README section 2.
# "pocketsphinx": bundled offline model, no network/GPU needed, materially
#   lower accuracy, no vocabulary-hint support. The only provider verified
#   working in network-restricted environments -- what this project's own
#   test suite uses (tests/conftest.py pins it regardless of this setting).
#   Set PROVIDER=pocketsphinx here for local dev without Hugging Face access.
PROVIDER=faster_whisper

# Only used when PROVIDER=faster_whisper.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

SAMPLE_RATE=16000
TESTED_LANGUAGES=en
EXPERIMENTAL_LANGUAGES=ar,fr,es

# Order-domain vocabulary hints applied to every session by default, unioned
# with whatever hints the client sends (e.g. a specific restaurant's menu
# typed into Settings). Only used by providers with supports_hints=True
# (faster_whisper; pocketsphinx ignores this entirely). The built-in default
# (see app/config.py) is a generic drive-thru/QSR starting point, not any
# real restaurant's menu -- override it here with real item/modifier names:
# DEFAULT_VOCABULARY_HINTS=Big Mac,McFlurry,no pickles,large fries,combo 3

MAX_QUEUED_FRAMES=150
FINALIZE_TIMEOUT_S=8.0
MAX_RECONNECT_ATTEMPTS=3
MAX_CONCURRENT_SESSIONS=20

# Comma-separated list of allowed browser origins for the WebSocket
# endpoint. Required for any non-localhost deployment.
ALLOWED_ORIGINS=http://localhost:5173

# Set REQUIRE_API_KEY=true and API_KEY=<a real secret> for any deployment
# reachable over the internet -- the WS endpoint has no auth by default,
# which is only appropriate for local development.
REQUIRE_API_KEY=false
API_KEY=
