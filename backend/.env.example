# Copy to .env and adjust. No secrets have defaults; nothing here is a
# real credential.

# "pocketsphinx" (default): bundled offline model, no network/GPU needed,
#   materially lower accuracy. Verified working in restricted sandboxes.
# "faster_whisper": production-quality accuracy, needs `pip install
#   faster-whisper` and network access to Hugging Face on first run.
PROVIDER=pocketsphinx

# Only used when PROVIDER=faster_whisper.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

SAMPLE_RATE=16000
TESTED_LANGUAGES=en
EXPERIMENTAL_LANGUAGES=ar,fr,es

MAX_QUEUED_FRAMES=150
FINALIZE_TIMEOUT_S=8.0
MAX_RECONNECT_ATTEMPTS=3
MAX_CONCURRENT_SESSIONS=20

# Comma-separated list of allowed browser origins for the WebSocket
# endpoint. Required for any non-localhost deployment.
ALLOWED_ORIGINS=http://localhost:5173

# Set REQUIRE_API_KEY=true and API_KEY=<a real secret> for any deployment
# reachable over the internet -- the WS endpoint has no auth by default,
# which is only appropriate for local development.
REQUIRE_API_KEY=false
API_KEY=
